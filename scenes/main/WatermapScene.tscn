plant_name = "碧山國小黑板"
plant_description = "黑板上用粉筆寫著最後一屆學生的名字。

林小明、陳阿福、王美玲……共七人。
1997年，永安國小正式停招。"

[node name="Memory_TeaShelf" parent="." unique_id=443676164 instance=ExtResource("6_info")]
position = Vector2(370, 621)
scale = Vector2(1.5, 1.5)
icon_frame = 3
plant_name = "茶葉貨架"
plant_description = "倒塌的貨架上，標籤依稀可辨：
「民國64年 全國包種茶競賽 特等獎」

碧山村曾是文山包種茶的故鄉。水庫蓄水後，輝煌的茶業隨著村莊一起沉入水底。"

[node name="Memory_Genealogy" parent="." unique_id=553855295 instance=ExtResource("6_info")]
position = Vector2(337, 400)
scale = Vector2(1.5, 1.5)
icon_frame = 9
plant_name = "族譜殘片"
plant_description = "老屋牆上，族譜的殘片仍黏著。

碧山村 406 戶、1100 人。
1979年動工，1987年蓄水。
四代人開墾的家，就這樣沉了。"

