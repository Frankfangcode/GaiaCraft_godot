[node name="Ghost_Shadow" parent="." unique_id=1926575814 instance=ExtResource("6_info")]
position = Vector2(736, 419)
scale = Vector2(1.5, 1.5)
icon_frame = 6
plant_name = "老屋殘影"
plant_description = "「你來了。我還以為這裡會被所有人忘掉。」

半透明的人影，像是阿公年輕時的樣子。

「鐵罐在那個角落。要拿走的話，記得告訴外面的人——我們在這裡住過。」"
